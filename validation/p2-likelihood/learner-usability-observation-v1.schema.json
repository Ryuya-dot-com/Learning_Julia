{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:learning-julia:p2:learner-usability-observation:1",
  "title": "Learning Julia P2 private learner usability observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "record_kind",
    "data_classification",
    "contains_direct_identifiers",
    "recording",
    "consent_confirmed",
    "session_code",
    "round_kind",
    "prerequisites",
    "interaction_modes",
    "tasks",
    "post_session"
  ],
  "properties": {
    "schema_id": { "const": "learning-julia.p2.learner-usability-observation" },
    "schema_version": { "const": "1.0.0" },
    "record_kind": { "enum": ["synthetic_example", "private_observation"] },
    "data_classification": { "const": "restricted_research_observation" },
    "contains_direct_identifiers": { "const": false },
    "recording": { "const": "none" },
    "consent_confirmed": { "const": true },
    "session_code": {
      "type": "string",
      "pattern": "^round-[0-9]{2}-p[0-9]{2}$"
    },
    "round_kind": { "enum": ["practice", "formative", "confirmation"] },
    "prerequisites": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "probability_distribution_lesson",
        "observation_boundary_lesson",
        "selection_count_prior_exposure"
      ],
      "properties": {
        "probability_distribution_lesson": { "type": "boolean" },
        "observation_boundary_lesson": { "type": "boolean" },
        "selection_count_prior_exposure": { "enum": ["none", "seen", "studied"] }
      }
    },
    "interaction_modes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "keyboard_pointer",
          "keyboard_only",
          "touch",
          "screen_reader",
          "magnification",
          "voice_control",
          "other_access_support"
        ]
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "allOf": [
        {
          "contains": { "type": "object", "required": ["task_id"], "properties": { "task_id": { "const": "denominator" } } },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": { "type": "object", "required": ["task_id"], "properties": { "task_id": { "const": "missingness" } } },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": { "type": "object", "required": ["task_id"], "properties": { "task_id": { "const": "conditional_vs_count" } } },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": { "type": "object", "required": ["task_id"], "properties": { "task_id": { "const": "unresolved_interval" } } },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": { "type": "object", "required": ["task_id"], "properties": { "task_id": { "const": "family_scope" } } },
          "minContains": 1,
          "maxContains": 1
        }
      ],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "completion",
          "teach_back_score",
          "prompt_count",
          "elapsed_seconds",
          "issue_codes"
        ],
        "properties": {
          "task_id": {
            "enum": [
              "denominator",
              "missingness",
              "conditional_vs_count",
              "unresolved_interval",
              "family_scope"
            ]
          },
          "completion": {
            "enum": [
              "independent",
              "minor_prompt",
              "major_prompt",
              "not_completed",
              "participant_stopped"
            ]
          },
          "teach_back_score": { "type": "integer", "minimum": 0, "maximum": 2 },
          "prompt_count": { "type": "integer", "minimum": 0, "maximum": 20 },
          "elapsed_seconds": {
            "oneOf": [
              { "type": "integer", "minimum": 0, "maximum": 3600 },
              { "type": "null" }
            ]
          },
          "issue_codes": {
            "type": "array",
            "maxItems": 10,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{2,63}$"
            }
          }
        }
      }
    },
    "post_session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "understood_material_not_person_tested",
        "understood_stop_any_time",
        "confidence_read_results",
        "fatigue"
      ],
      "properties": {
        "understood_material_not_person_tested": { "type": "boolean" },
        "understood_stop_any_time": { "type": "boolean" },
        "confidence_read_results": { "type": "integer", "minimum": 1, "maximum": 5 },
        "fatigue": { "type": "integer", "minimum": 1, "maximum": 5 }
      }
    }
  }
}

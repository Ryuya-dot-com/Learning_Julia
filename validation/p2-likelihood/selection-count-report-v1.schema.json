{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:learning-julia:p2:selection-count-report:1",
  "title": "Learning Julia P2 selection-count interval report",
  "description": "Research-only exchange contract. Null interval endpoints mean unresolved, not zero.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "model_scope", "reports"],
  "properties": {
    "schema_id": { "const": "learning-julia.p2.selection-count-report" },
    "schema_version": { "const": "1.0.0" },
    "model_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "selection_rule", "automatic_interval_selection"],
      "properties": {
        "family": { "const": "Normal" },
        "selection_rule": { "const": "strict_open_interval" },
        "automatic_interval_selection": { "const": false }
      }
    },
    "reports": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/report" }
    }
  },
  "$defs": {
    "input_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_screened", "selected_count", "lower_boundary", "upper_boundary", "boundary_rule"],
      "properties": {
        "total_screened": { "type": "integer", "minimum": 2 },
        "selected_count": { "type": "integer", "minimum": 2 },
        "lower_boundary": { "type": "number" },
        "upper_boundary": { "type": "number" },
        "boundary_rule": { "const": "lower < value < upper" }
      }
    },
    "interval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parameter", "lower", "upper"],
      "properties": {
        "parameter": { "enum": ["mu", "sigma"] },
        "lower": { "type": ["number", "null"] },
        "upper": { "type": ["number", "null"] }
      }
    },
    "diagnostics": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["total_screened", "repetitions", "successes", "success_rate", "minimum_success_rate"],
      "properties": {
        "total_screened": { "type": "integer", "minimum": 2 },
        "repetitions": { "type": "integer", "minimum": 1 },
        "successes": { "type": "integer", "minimum": 0 },
        "success_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "minimum_success_rate": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "status", "intervals", "diagnostics"],
      "properties": {
        "method": { "enum": ["wald", "profile", "bootstrap"] },
        "status": { "enum": ["ok", "search_limit", "skipped_weak_identification", "error", "insufficient_success"] },
        "intervals": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/interval" }
        },
        "diagnostics": { "$ref": "#/$defs/diagnostics" }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report_id", "status", "automatic_interval", "input_contract", "methods", "messages"],
      "properties": {
        "report_id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["review_profile_and_bootstrap", "unresolved_profile", "unresolved_bootstrap"] },
        "automatic_interval": { "type": "null" },
        "input_contract": { "$ref": "#/$defs/input_contract" },
        "methods": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/method" }
        },
        "messages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "wald_is_local_approximation",
              "profile_interval_unresolved",
              "profile_skipped_weak_identification",
              "profile_computation_error",
              "bootstrap_success_rate_too_low",
              "compare_profile_and_bootstrap"
            ]
          }
        }
      }
    }
  }
}

{
  "name": "learning-julia",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/p2-participant-preview-build-check.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "vite build --outDir .e2e-dist && playwright test",
    "test:p2-ui": "playwright test --config=playwright.p2.config.js",
    "test:p2-api": "playwright test --config=playwright.p2.local.config.js",
    "postinstall": "node scripts/dropbox-ignore.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-react": "^6.0.5",
    "vite": "^8.3.1",
    "vitest": "^3.2.7"
  }
}
